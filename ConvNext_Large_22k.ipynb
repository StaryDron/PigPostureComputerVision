   "source": [
    "def parse_camera_meta(image_id):\n",
    "    m = re.match(r'(pen\\d+)_(orb|tur)_(cam\\d+)_', str(image_id))\n",
    "    return (m.group(1), m.group(2), m.group(3)) if m else ('unknown', 'unknown', 'unknown')\n",
    "\n",
    "def add_camera_cols(df):\n",
    "    df['pen']      = df['image_id'].apply(lambda x: parse_camera_meta(x)[0])\n",
    "    df['cam_type'] = df['image_id'].apply(lambda x: parse_camera_meta(x)[1])\n",
    "    df['cam_num']  = df['image_id'].apply(lambda x: parse_camera_meta(x)[2])\n",
    "    df['camera']   = df['pen'] + '_' + df['cam_type'] + '_' + df['cam_num']\n",
    "    return df\n",
    "\n",
    "train2 = pd.read_csv(BASE_DIR / 'train2.csv')\n",
    "train2['source']      = 'train2'\n",
    "train2['bbox_parsed'] = train2['bbox'].apply(ast.literal_eval)\n",
    "train2['class_name']  = train2['class_id'].map(CLASS_NAMES)\n",
    "train2 = add_camera_cols(train2)\n",
    "\n",
    "test = pd.read_csv(BASE_DIR / 'test.csv')\n",
    "test['source']      = 'test'\n",
    "test['bbox_parsed'] = test['bbox'].apply(ast.literal_eval)\n",
    "test = add_camera_cols(test)\n",
    "\n",
    "print(f'Train2: {len(train2):,} instancji  |  {train2[\"image_id\"].nunique():,} zdjęć')\n",
    "print(f'Test:   {len(test):,} instancji   |  {test[\"image_id\"].nunique():,} zdjęć')\n",
    "print('\\nRozkład klas (train2):')\n",
    "for cname, cnt in train2['class_name'].value_counts().items():\n",
    "    print(f'  {cname:25s}: {cnt:,}')"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "cell-md-img",
   "metadata": {},
   "source": [
    "## Narzędzia obrazu — crop bez paddingu (padding=0%)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cell-06",
   "metadata": {},
   "outputs": [],
   "source": [
    "def load_image(image_id, source):\n",
    "    folder = {'train2': TRAIN2_IMGS, 'test': TEST_IMGS}[source]\n",
    "    return Image.open(folder / image_id).convert('RGB')\n",
    "\n",
    "def crop_bbox(image, bbox):\n",
    "    \"\"\"Bezpośredni crop z bboxa — padding=0%.\"\"\"\n",
    "    img_w, img_h = image.size\n",
    "    x, y, w, h   = map(float, bbox)\n",
    "    x1 = max(0, int(round(x)))\n",
    "    y1 = max(0, int(round(y)))\n",
    "    x2 = min(img_w, int(round(x + w)))\n",
    "    y2 = min(img_h, int(round(y + h)))\n",
    "    return image.crop((x1, y1, max(x2, x1 + 1), max(y2, y1 + 1)))"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "cell-md-aug",
   "metadata": {},
   "source": [
    "## Augmentacje per kamera\n",
    "\n",
    "Identyczne z `EficientNet_Augmentacja.ipynb`. Kamery z flipem poziomym wymagają zamiany etykiet 0 (left) ↔ 1 (right)."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cell-07",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Horizontal flip wymaga zamiany: Lateral_lying_left (0) ↔ Lateral_lying_right (1)\n",
    "FLIP_LABEL_MAP = {0: 1, 1: 0, 2: 2, 3: 3, 4: 4}\n",
    "\n",
    "def aug_pen2_tur_cam1(img):\n",
    "    img = TF.hflip(img)\n",
    "    img = TF.adjust_saturation(img, saturation_factor=0.8)\n",
    "    return TF.adjust_brightness(img, brightness_factor=0.95)\n",
    "\n",
    "def aug_pen1_tur_cam2(img):\n",
    "    img = TF.hflip(img)\n",
    "    img = TF.adjust_brightness(img, brightness_factor=1.35)\n",
    "    return TF.adjust_saturation(img, saturation_factor=0.9)\n",
    "\n",
    "def aug_pen2_orb_cam1(img):\n",
    "    img = TF.hflip(img)\n",
    "    img = TF.adjust_brightness(img, brightness_factor=0.6)\n",
    "    img = TF.adjust_contrast(img, contrast_factor=1.5)\n",
    "    arr = np.array(img).astype(float)\n",
    "    arr[:, :, 0] = (arr[:, :, 0] * 0.85).clip(0, 255)\n",
    "    arr[:, :, 1] = (arr[:, :, 1] * 1.10).clip(0, 255)\n",
    "    arr[:, :, 2] = (arr[:, :, 2] * 0.80).clip(0, 255)\n",
    "    shifted = Image.fromarray(arr.clip(0, 255).astype(np.uint8))\n",
    "    grey    = np.array(TF.to_grayscale(shifted, num_output_channels=3)).astype(float)\n",
    "    return Image.fromarray((0.65 * arr + 0.35 * grey).clip(0, 255).astype(np.uint8))\n",
    "\n",
    "def aug_pen2_tur_cam2(img):\n",
    "    img = TF.adjust_brightness(img, brightness_factor=1.3)\n",
    "    return TF.adjust_saturation(img, saturation_factor=0.85)\n",
    "\n",
    "def aug_pen2_orb_cam2(img):\n",
    "    img  = TF.adjust_brightness(img, brightness_factor=0.60)\n",
    "    img  = TF.adjust_contrast(img, contrast_factor=1.5)\n",
    "    arr  = np.array(img).astype(float)\n",
    "    grey = np.array(TF.to_grayscale(img, num_output_channels=3)).astype(float)\n",
    "    return Image.fromarray((0.65 * arr + 0.35 * grey).clip(0, 255).astype(np.uint8))\n",
    "\n",
    "CAMERA_AUG_FN = {\n",
    "    'pen2_tur_cam1': (aug_pen2_tur_cam1, True),\n",
    "    'pen1_tur_cam2': (aug_pen1_tur_cam2, True),\n",
    "    'pen2_orb_cam1': (aug_pen2_orb_cam1, True),\n",
    "    'pen2_tur_cam2': (aug_pen2_tur_cam2, False),\n",
    "    'pen2_orb_cam2': (aug_pen2_orb_cam2, False),\n",
    "}\n",
    "\n",
    "print('Augmentacje per kamera:')\n",
    "for cam, (_, flip) in CAMERA_AUG_FN.items():\n",
    "    print(f'  {cam:20s}  flip={flip}  label_swap={flip}')"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "cell-md-tf",
   "metadata": {},
   "source": [
    "## Transformacje"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cell-08",
   "metadata": {},
   "outputs": [],
   "source": [
    "class AddGaussianNoise:\n",
    "    def __init__(self, std=0.02, p=0.15):\n",
    "        self.std, self.p = std, p\n",
    "    def __call__(self, t):\n",
    "        if torch.rand(1).item() < self.p:\n",
    "            t = torch.clamp(t + torch.randn_like(t) * self.std, 0., 1.)\n",
    "        return t\n",
    "\n",
    "MU  = [0.485, 0.456, 0.406]\n",
    "STD = [0.229, 0.224, 0.225]\n",
    "\n",
    "BASE_TRANSFORM = transforms.Compose([\n",
    "    transforms.Resize((IMG_SIZE, IMG_SIZE)),\n",
    "    transforms.ToTensor(),\n",
    "    AddGaussianNoise(std=0.02, p=0.15),\n",
    "    transforms.Normalize(MU, STD),\n",
    "])\n",
    "\n",
    "VAL_TRANSFORM = transforms.Compose([\n",
    "    transforms.Resize((IMG_SIZE, IMG_SIZE)),\n",
    "    transforms.ToTensor(),\n",
    "    transforms.Normalize(MU, STD),\n",
    "])\n",
    "\n",
    "print('Transforms ✓')"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "cell-md-ds",
   "metadata": {},
   "source": [
    "## Klasy datasetów"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cell-09",
   "metadata": {},
   "outputs": [],
   "source": [
    "class PigDatasetCameraAug(Dataset):\n",
    "    \"\"\"Dla każdej próbki dodaje wersję camera-aug z label-swapem przy flipie L↔R.\"\"\"\n",
    "    def __init__(self, df, camera_aug_fn, base_transform, is_train=True):\n",
    "        self.camera_aug_fn  = camera_aug_fn\n",
    "        self.base_transform = base_transform\n",
    "        df = df.reset_index(drop=True)\n",
    "        self.df = df\n",
    "        self.samples = []\n",
    "        for idx, row in df.iterrows():\n",
    "            cam   = row.get('camera', 'unknown')\n",
    "            label = int(row['class_id'])\n",
    "            self.samples.append((idx, False, label))\n",
    "            if is_train and cam in camera_aug_fn:\n",
    "                _, does_flip = camera_aug_fn[cam]\n",
    "                self.samples.append(\n",
    "                    (idx, True, FLIP_LABEL_MAP[label] if does_flip else label)\n",
    "                )\n",
    "\n",
    "    def __len__(self):\n",
    "        return len(self.samples)\n",
    "\n",
    "    def __getitem__(self, i):\n",
    "        row_i, do_aug, label = self.samples[i]\n",
    "        row  = self.df.iloc[row_i]\n",
    "        img  = load_image(row['image_id'], row['source'])\n",
    "        crop = crop_bbox(img, row['bbox_parsed'])\n",
    "        if do_aug:\n",
    "            aug_fn, _ = self.camera_aug_fn[row['camera']]\n",
    "            crop = aug_fn(crop)\n",
    "        return self.base_transform(crop), label\n",
    "\n",
    "\n",
    "class PigTestDataset(Dataset):\n",
    "    def __init__(self, df, transform):\n",
    "        self.df        = df.reset_index(drop=True)\n",
    "        self.transform = transform\n",
    "\n",
    "    def __len__(self):\n",
    "        return len(self.df)\n",
    "\n",
    "    def __getitem__(self, i):\n",
    "        row  = self.df.iloc[i]\n",
    "        img  = load_image(row['image_id'], row['source'])\n",
    "        crop = crop_bbox(img, row['bbox_parsed'])\n",
    "        return self.transform(crop), str(row['row_id'])\n",
    "\n",
    "\n",
    "print('Dataset classes ✓')"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "cell-md-dl",
   "metadata": {},
   "source": [
    "## DataLoader z WeightedRandomSampler"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cell-10",
   "metadata": {},
   "outputs": [],
   "source": [
    "def build_weighted_loader(dataset, labels, batch_size, num_workers=2):\n",
    "    labels  = np.asarray(labels, dtype=int)\n",
    "    counts  = np.bincount(labels, minlength=NUM_CLASSES)\n",
    "    weights = (1.0 / np.maximum(counts, 1))[labels]\n",
    "    sampler = WeightedRandomSampler(\n",
    "        weights=torch.DoubleTensor(weights),\n",
    "        num_samples=len(weights),\n",
    "        replacement=True,\n",
    "    )\n",
    "    return DataLoader(\n",
    "        dataset, batch_size=batch_size, sampler=sampler,\n",
    "        num_workers=num_workers, pin_memory=True,\n",
    "        persistent_workers=(num_workers > 0),\n",
    "    )\n",
    "\n",
    "\n",
    "train_ds     = PigDatasetCameraAug(train2, CAMERA_AUG_FN, BASE_TRANSFORM)\n",
    "train_labels = [s[2] for s in train_ds.samples]\n",
    "train_loader = build_weighted_loader(train_ds, train_labels, BATCH_SIZE)\n",
    "\n",
    "counts_aug = np.bincount(train_labels, minlength=NUM_CLASSES)\n",
    "print(f'Próbki po camera-aug: {len(train_ds):,}  |  batchy: {len(train_loader)}')\n",
    "print('\\nRozkład klas po aug:')\n",
    "for cid, cnt in enumerate(counts_aug):\n",
    "    bar = '█' * int(20 * cnt / counts_aug.max())\n",
    "    print(f'  [{cid}] {CLASS_NAMES[cid]:25s}: {cnt:>6,}  {bar}')"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "cell-md-model",
   "metadata": {},
   "source": [
    "## Model: ConvNext Large (22k) + utilities freeze/unfreeze\n",
    "\n",
    "### Architektura ConvNext Large\n",
    "| Stage | Bloki | Kanały | Params/blok | Łącznie |\n",
    "|-------|-------|--------|-------------|--------|\n",
    "| 0 | 3 | 192 | ~0.74M | ~2.2M |\n",
    "| 1 | 3 | 384 | ~2.96M | ~8.9M |\n",
    "| 2 | 27 | 768 | ~4.76M | ~128.5M |\n",
    "| 3 | 3 | 1536 | ~18.96M | ~56.9M |\n",
    "\n",
    "**Faza 2:** ostatnie 15 bloków stage 2 (~71M) + cały stage 3 (~57M) + head ≈ **128M trainable**"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cell-11",
   "metadata": {},
   "outputs": [],
   "source": [
    "def bare(m):\n",
    "    \"\"\"Zwraca model spod DataParallel wrappera.\"\"\"\n",
    "    return m.module if hasattr(m, 'module') else m\n",
    "\n",
    "def n_trainable(m):\n",
    "    return sum(p.numel() for p in bare(m).parameters() if p.requires_grad)\n",
    "\n",
    "def n_total(m):\n",
    "    return sum(p.numel() for p in bare(m).parameters())\n",
    "\n",
    "def freeze_all(m):\n",
    "    for p in bare(m).parameters():\n",
    "        p.requires_grad = False\n",
    "\n",
    "\n",
    "def unfreeze_head_only(m):\n",
    "    \"\"\"Faza 1: tylko głowa klasyfikatora (LayerNorm + Linear ≈ 10K params).\"\"\"\n",
    "    freeze_all(m)\n",
    "    for p in bare(m).head.parameters():\n",
    "        p.requires_grad = True\n",
    "    print(f'  Faza 1 — head only  |  trainable: {n_trainable(m):,} / {n_total(m):,}')\n",
    "\n",
    "\n",
    "def unfreeze_for_phase2(m, stage3_last_n=15):\n",
    "    \"\"\"\n",
    "    Faza 2: ostatnie stage3_last_n bloków stage 2 (768ch)\n",
    "             + cały stage 3 (1536ch) + head.\n",
    "    Domyślnie (n=15): ~71M + ~57M + ~10K ≈ 128M trainable.\n",
    "\n",
    "    Uwaga: indeksacja timm — stages[2] = 3. stage (768ch), stages[3] = 4. stage (1536ch).\n",
    "    \"\"\"\n",
    "    freeze_all(m)\n",
    "    model_bare = bare(m)\n",
    "\n",
    "    # Cały stage 3 (1536ch, 3 bloki × ~19M = ~57M)\n",
    "    for p in model_bare.stages[3].parameters():\n",
    "        p.requires_grad = True\n",
    "\n",
    "    # Ostatnie N bloków stage 2 (768ch)\n",
    "    stage2_blocks = list(model_bare.stages[2].blocks)\n",
    "    n = min(stage3_last_n, len(stage2_blocks))\n",
    "    for blk in stage2_blocks[-n:]:\n",
    "        for p in blk.parameters():\n",
    "            p.requires_grad = True\n",
    "\n",
    "    # Głowa\n",
    "    for p in model_bare.head.parameters():\n",
    "        p.requires_grad = True\n",
    "\n",
    "    tr = n_trainable(m)\n",
    "    tot = n_total(m)\n",
    "    print(f'  Faza 2 — ostatnie {n}/{len(stage2_blocks)} bloków stage[2] + cały stage[3] + head')\n",
    "    print(f'  Trainable: {tr:,} / {tot:,} ({100 * tr / tot:.1f}%)')\n",
    "\n",
    "\n",
    "# ── Inicjalizacja modelu ──────────────────────────────────────────────────────\n",
    "print(f'Ładowanie: {CONVNEXT_MODEL} ...')\n",
    "_base = timm.create_model(CONVNEXT_MODEL, pretrained=True, num_classes=NUM_CLASSES)\n",
    "_base = _base.to(DEVICE)\n",
    "\n",
    "print(f'Stages: {len(_base.stages)}')\n",
    "for i, stage in enumerate(_base.stages):\n",
    "    n_blk = len(list(stage.blocks))\n",
    "    print(f'  stages[{i}]: {n_blk} bloków')\n",
    "print(f'Łącznie: {n_total(_base):,} params')\n",
    "\n",
    "with torch.no_grad():\n",
    "    _x = torch.randn(2, 3, IMG_SIZE, IMG_SIZE, device=DEVICE)\n",
    "    _y = _base(_x)\n",
    "    print(f'Forward: {tuple(_x.shape)} → {tuple(_y.shape)}  ✓')\n",
    "\n",
    "model = _base\n",
    "if USE_DATA_PARALLEL:\n",
    "    model = nn.DataParallel(model)\n",
    "    print(f'✓ DataParallel na {NUM_GPUS} GPU ({BATCH_SIZE // NUM_GPUS}/GPU)')\n",
    "else:\n",
    "    print('  DataParallel wyłączony')"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "cell-md-train",
   "metadata": {},
   "source": [
    "## Narzędzia treningowe"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cell-12",
   "metadata": {},
   "outputs": [],
   "source": [
    "scaler = torch.amp.GradScaler('cuda', enabled=(AMP_DTYPE == torch.float16))\n",
    "\n",
    "\n",
    "def train_one_epoch(model, loader, optimizer, criterion):\n",
    "    model.train()\n",
    "    total_loss, preds_all, targets_all = 0.0, [], []\n",
    "    n = len(loader)\n",
    "    for bi, (imgs, labels) in enumerate(loader):\n",
    "        imgs   = imgs.to(DEVICE, non_blocking=True)\n",
    "        labels = labels.to(DEVICE, non_blocking=True)\n",
    "        optimizer.zero_grad(set_to_none=True)\n",
    "\n",
    "        with torch.amp.autocast('cuda', dtype=AMP_DTYPE, enabled=(DEVICE.type == 'cuda')):\n",
    "            out  = model(imgs)\n",
    "            loss = criterion(out, labels)\n",
    "\n",
    "        trainable_params = [p for p in model.parameters() if p.requires_grad]\n",
    "        if AMP_DTYPE == torch.float16:\n",
    "            scaler.scale(loss).backward()\n",
    "            scaler.unscale_(optimizer)\n",
    "            torch.nn.utils.clip_grad_norm_(trainable_params, 1.0)\n",
    "            scaler.step(optimizer)\n",
    "            scaler.update()\n",
    "        else:\n",
    "            loss.backward()\n",
    "            torch.nn.utils.clip_grad_norm_(trainable_params, 1.0)\n",
    "            optimizer.step()\n",
    "\n",
    "        total_loss += loss.item() * imgs.size(0)\n",
    "        preds_all.extend(out.argmax(1).detach().cpu().tolist())\n",
    "        targets_all.extend(labels.cpu().tolist())\n",
    "        bar = '█' * int(30 * (bi + 1) / n) + '░' * (30 - int(30 * (bi + 1) / n))\n",
    "        print(f'\\r  |{bar}| {100 * (bi + 1) / n:5.1f}%  loss={loss.item():.4f}',\n",
    "              end='', flush=True)\n",
    "    print()\n",
    "    return (\n",
    "        total_loss / len(loader.dataset),\n",
    "        accuracy_score(targets_all, preds_all),\n",
    "        f1_score(targets_all, preds_all, average='macro', zero_division=0),\n",
    "    )\n",
    "\n",
    "\n",
    "def save_checkpoint(epoch, model, optimizer, scheduler, best_f1, history, path):\n",
    "    torch.save({\n",
    "        'epoch':                epoch,\n",
    "        'model_state_dict':     bare(model).state_dict(),\n",
    "        'optimizer_state_dict': optimizer.state_dict(),\n",
    "        'scheduler_state_dict': scheduler.state_dict() if scheduler else None,\n",
    "        'best_f1':              best_f1,\n",
    "        'history':              history,\n",
    "    }, path)\n",
    "\n",
    "\n",
    "def load_checkpoint(path, model, optimizer=None, scheduler=None):\n",
    "    \"\"\"Wczytuje checkpoint. Zwraca (start_epoch, best_f1, history) lub (0, 0.0, []).\"\"\"\n",
    "    if not os.path.exists(path):\n",
    "        return 0, 0.0, []\n",
    "    ckpt = torch.load(path, map_location=DEVICE)\n",
    "    bare(model).load_state_dict(ckpt['model_state_dict'])\n",
    "    if optimizer and 'optimizer_state_dict' in ckpt:\n",
    "        optimizer.load_state_dict(ckpt['optimizer_state_dict'])\n",
    "    if scheduler and ckpt.get('scheduler_state_dict'):\n",
    "        scheduler.load_state_dict(ckpt['scheduler_state_dict'])\n",
    "    start   = ckpt.get('epoch', 0) + 1\n",
    "    best_f1 = ckpt.get('best_f1', 0.0)\n",
    "    history = ckpt.get('history', [])\n",
    "    print(f'  ✓ Checkpoint wczytany: {path}  '\n",
    "          f'(epoka {ckpt.get(\"epoch\", 0)}, best F1={best_f1:.4f})')\n",
    "    return start, best_f1, history\n",
    "\n",
    "\n",
    "def run_stage(model, loader, criterion, optimizer, scheduler,\n",
    "              n_epochs, stage_name, ckpt_path, best_path,\n",
    "              history, best_f1, best_state, start_epoch=0):\n",
    "    print(f'\\n{\"─\" * 65}')\n",
    "    print(f'{stage_name}')\n",
    "    print(f'Trainable: {n_trainable(model):,} / {n_total(model):,} params')\n",
    "    print(f'{\"─\" * 65}')\n",
    "    if start_epoch > 0:\n",
    "        print(f'  Wznawianie od epoki {start_epoch + 1}/{n_epochs}')\n",
    "\n",
    "    if best_state is None:\n",
    "        best_state = copy.deepcopy(bare(model).state_dict())\n",
    "\n",
    "    for epoch in range(start_epoch, n_epochs):\n",
    "        t0 = time.time()\n",
    "        loss, acc, f1 = train_one_epoch(model, loader, optimizer, criterion)\n",
    "        if scheduler:\n",
    "            scheduler.step()\n",
    "        elapsed = time.time() - t0\n",
    "\n",
    "        flag   = '  ← best' if f1 > best_f1 else ''\n",
    "        lr_now = optimizer.param_groups[0]['lr']\n",
    "        print(f'  Ep {epoch + 1:>2}/{n_epochs} ({elapsed / 60:.1f}m)  '\n",
    "              f'loss={loss:.4f}  acc={acc:.4f}  f1={f1:.4f}  lr={lr_now:.1e}{flag}',\n",
    "              flush=True)\n",
    "\n",
    "        history.append({\n",
    "            'stage':       stage_name,\n",
    "            'epoch':       epoch + 1,\n",
    "            'global_ep':   len(history) + 1,\n",
    "            'train_loss':  loss,\n",
    "            'train_acc':   acc,\n",
    "            'train_f1':    f1,\n",
    "        })\n",
    "\n",
    "        if f1 > best_f1:\n",
    "            best_f1    = f1\n",
    "            best_state = copy.deepcopy(bare(model).state_dict())\n",
    "            torch.save({\n",
    "                'model_state_dict': best_state,\n",
    "                'best_f1':          best_f1,\n",
    "                'model_name':       CONVNEXT_MODEL,\n",
    "                'epoch':            epoch + 1,\n",
    "                'stage':            stage_name,\n",
    "            }, best_path)\n",
    "            print(f'  💾 Best → {best_path}', flush=True)\n",
    "\n",
    "        # Checkpoint po każdej epoce — do wznowienia po przerwaniu\n",
    "        save_checkpoint(epoch, model, optimizer, scheduler, best_f1, history, ckpt_path)\n",
    "\n",
    "    return best_f1, best_state\n",
    "\n",
    "\n",
    "def plot_history(history, vlines=None, title='', fname=None):\n",
    "    df = pd.DataFrame(history)\n",
    "    fig, axes = plt.subplots(1, 2, figsize=(14, 5))\n",
    "    for col, ax, color, ylabel in [\n",
    "        ('train_loss', axes[0], 'steelblue', 'Focal Loss'),\n",
    "        ('train_f1',   axes[1], 'green',     'Macro F1'),\n",
    "    ]:\n",
    "        ax.plot(df['global_ep'], df[col], marker='o', markersize=3, color=color)\n",
    "        if vlines:\n",
    "            for vx, lbl in vlines:\n",
    "                ax.axvline(vx, color='gray', linestyle=':', alpha=0.7, label=lbl)\n",
    "            ax.legend(fontsize=8)\n",
    "        ax.set_xlabel('Epoka')\n",
    "        ax.set_ylabel(ylabel)\n",
    "        ax.grid(alpha=0.3)\n",
    "    best = df['train_f1'].max()\n",
    "    axes[1].axhline(best, color='red', linestyle='--', linewidth=1, label=f'best={best:.4f}')\n",
    "    axes[1].legend()\n",
    "    plt.suptitle(title, fontsize=13, fontweight='bold')\n",
    "    plt.tight_layout()\n",
    "    if fname:\n",
    "        plt.savefig(fname, dpi=130, bbox_inches='tight')\n",
    "    plt.show()\n",
    "    return best\n",
    "\n",
    "\n",
    "print('Training utilities ✓')"
   ]
  },
