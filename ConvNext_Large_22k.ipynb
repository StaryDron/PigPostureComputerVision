    "test_loader = DataLoader(\n",
    "    PigTestDataset(test, VAL_TRANSFORM),\n",
    "    batch_size  = BATCH_SIZE,\n",
    "    shuffle     = False,\n",
    "    num_workers = 2,\n",
    "    pin_memory  = True,\n",
    ")\n",
    "\n",
    "# Permutacja kolumn prawdopodobieństwa dla flipowanego obrazu: left↔right\n",
    "FLIP_PERM = torch.tensor([1, 0, 2, 3, 4], device=DEVICE)\n",
    "\n",
    "all_row_ids = []\n",
    "all_probs   = []\n",
    "\n",
    "model.eval()\n",
    "with torch.no_grad():\n",
    "    n_batches = len(test_loader)\n",
    "    for bi, (imgs, row_ids) in enumerate(test_loader):\n",
    "        imgs = imgs.to(DEVICE, non_blocking=True)\n",
    "\n",
    "        # Przebieg 1: oryginał\n",
    "        with torch.amp.autocast('cuda', dtype=AMP_DTYPE, enabled=(DEVICE.type == 'cuda')):\n",
    "            logits_orig = model(imgs)\n",
    "        probs_orig = torch.softmax(logits_orig.float(), dim=1)\n",
    "\n",
    "        # Przebieg 2: hflip + korekta klas\n",
    "        imgs_flip = torch.flip(imgs, dims=[-1])\n",
    "        with torch.amp.autocast('cuda', dtype=AMP_DTYPE, enabled=(DEVICE.type == 'cuda')):\n",
    "            logits_flip = model(imgs_flip)\n",
    "        probs_flip = torch.softmax(logits_flip.float(), dim=1)\n",
    "        probs_flip = probs_flip[:, FLIP_PERM]  # zamień kolumny 0↔1 (left↔right)\n",
    "\n",
    "        probs = (probs_orig + probs_flip) * 0.5\n",
    "\n",
    "        all_row_ids.extend(list(row_ids))\n",
    "        all_probs.append(probs.cpu())\n",
    "\n",
    "        bar = '█' * int(30 * (bi + 1) / n_batches) + '░' * (30 - int(30 * (bi + 1) / n_batches))\n",
    "        print(f'\\r  |{bar}| {bi + 1}/{n_batches}  TTA (orig+flip)',\n",
    "              end='', flush=True)\n",
    "\n",
    "print(f'\\n{len(all_row_ids):,} predykcji (TTA ×2) ✓')\n",
    "\n",
    "all_probs = torch.cat(all_probs, dim=0)   # (N, 5)\n",
    "all_preds = all_probs.argmax(dim=1).numpy()"
   ]
